# NextAuth
NEXTAUTH_URL=https://rank-own.vercel.app
NEXTAUTH_SECRET=

# Google OAuth (Search Console + optional Ads)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Ads Keyword Planner (free official API)
# Customer ID from ads.google.com (numbers only, no dashes)
GOOGLE_ADS_CUSTOMER_ID=
# Optional if using manager account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Developer token if your project still requires it
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional server-side refresh token (same Google user with Ads access)
GOOGLE_ADS_REFRESH_TOKEN=
